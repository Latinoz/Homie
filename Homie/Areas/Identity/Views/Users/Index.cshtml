@model IEnumerable<Homie.Areas.Identity.Models.User>
@{
    ViewBag.Title = "Список пользователей";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<a asp-action="Create" class="btn btn-success mb-3">Добавить пользователя</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Email</th>
            <th>Год</th>
            <th>Статус</th>
            <th>Неудачных попыток</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            var isLocked = user.LockoutEnd.HasValue && user.LockoutEnd.Value > DateTimeOffset.UtcNow;
            <tr class="@(isLocked ? "table-danger" : "")">
                <td>@user.Email</td>
                <td>@user.Year</td>
                <td>
                    @if (isLocked)
                    {
                        <span class="badge badge-danger">
                            <i class="fas fa-lock"></i> Заблокирован до @user.LockoutEnd.Value.ToLocalTime().ToString("HH:mm:ss")
                        </span>
                    }
                    else
                    {
                        <span class="badge badge-success">
                            <i class="fas fa-check"></i> Активен
                        </span>
                    }
                </td>
                <td>
                    @if (user.AccessFailedCount > 0)
                    {
                        <span class="badge badge-warning">@user.AccessFailedCount</span>
                    }
                    else
                    {
                        <span class="text-muted">0</span>
                    }
                </td>
                <td>
                    <div class="btn-group" role="group">
                        <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@user.Id" title="Изменить">
                            <i class="fas fa-edit"></i>
                        </a>
                        <a class="btn btn-sm btn-info" asp-action="ChangePassword" asp-route-id="@user.Id" title="Сменить пароль">
                            <i class="fas fa-key"></i>
                        </a>
                        
                        @if (isLocked)
                        {
                            <form asp-action="UnlockAccount" asp-route-id="@user.Id" method="post" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-warning" title="Разблокировать аккаунт" 
                                        onclick="return confirm('Разблокировать аккаунт @user.Email?');">
                                    <i class="fas fa-unlock"></i>
                                </button>
                            </form>
                        }
                        
                        <form asp-action="Delete" asp-route-id="@user.Id" method="post" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-danger" title="Удалить"
                                    onclick="return confirm('Удалить пользователя @user.Email?');">
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
        }
</table>

