@using Homie.Models
@model IndexViewModel

@{
    ViewBag.Title = "Список сериалов";
    ViewBag.HeaderTitle = "Сериалы - [Избранное]";
}

<style>
    @@font-face {
        font-family: 'FontAwesome';
        src: url('https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/fonts/fontawesome-webfont.woff2') format('woff2'), 
            url('https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/fonts/fontawesome-webfont.woff') format('woff'), 
            url('https://maxcdn.bootstrapcdn.com/font-awesome/4.4.0/fonts/fontawesome-webfont.ttf') format('truetype');
        font-weight: normal;
        font-style: normal
    }

    .glyphicon {
        display: inline-block;
        font: normal normal normal 14px/1 FontAwesome;
        font-size: inherit;
        text-rendering: auto;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale
    }

    .glyphicon-chevron-right:before {
        content: "\f054";
    }

    .glyphicon-chevron-left:before {
        content: "\f053";
    }

    .scroll-x {
        overflow-x: auto;
    }
</style>

<a asp-action="CreateIntoFavorite" asp-controller="Serie" asp-area="Series"
   class="btn btn-primary"
   role="button">Добавить</a>
<p></p>

<div class="form-inline" style="position: relative;">
    <label>Поиск: </label>
    <div style="position: relative;">
        <input type="text" id="movieSearch" class="form-control" placeholder="Введите название сериала..." style="width: 300px;" />
        <div id="searchResults" style="position: absolute; z-index: 1000; background: white; border: 1px solid #ccc; max-height: 300px; overflow-y: auto; display: none; width: 300px; top: 100%; left: 0; margin-top: 2px; box-shadow: 0 2px 5px rgba(0,0,0,0.2);"></div>
    </div>
</div>
<p></p>

<script>
    $(document).ready(function() {
            var searchInput = $('#movieSearch');
            var searchResults = $('#searchResults');
            var timeout = null;

            searchInput.on('input', function() {
                var term = $(this).val().trim();

                // Очищаем предыдущий таймаут
                if (timeout) {
                    clearTimeout(timeout);
                }

                if (term.length < 2) {
                    searchResults.hide().empty();
                    return;
                }

                // Задержка перед отправкой запроса (debounce)
                timeout = setTimeout(function() {
                    $.ajax({
                        url: '@Url.Action("SearchMovies", "Serie", new { area = "Series" })',
                        type: 'GET',
                        data: { term: term },
                        success: function(data) {
                            searchResults.empty();
                            if (data && data.length > 0) {
                                $.each(data, function(index, item) {
                                    var div = $('<div>').addClass('search-result-item')
                                        .css({
                                            'padding': '8px',
                                            'cursor': 'pointer',
                                            'border-bottom': '1px solid #eee'
                                        })
                                        .hover(
                                            function() { $(this).css('background-color', '#f0f0f0'); },
                                            function() { $(this).css('background-color', ''); }
                                        )
                                        .text(item.label)
                                        .data('id', item.id)
                                        .on('click', function() {
                                            var movieId = $(this).data('id');
                                            window.location.href = '@Url.Action("Edit", "Serie", new { area = "Series" })?id=' + movieId;
                                        });
                                    searchResults.append(div);
                                });
                                searchResults.show();
                            } else {
                                searchResults.hide();
                            }
                        },
                        error: function() {
                            searchResults.hide();
                        }
                    });
                }, 300); // Задержка 300мс
            });

            // Скрываем результаты при клике вне области поиска
            $(document).on('click', function(e) {
                if (!$(e.target).closest('#movieSearch, #searchResults').length) {
                    searchResults.hide();
                }
            });

            // Скрываем результаты при нажатии ESC
            searchInput.on('keydown', function(e) {
                if (e.key === 'Escape') {
                    searchResults.hide();
                }
            });
        });
</script>

<div class="scroll-x">
    <table class="table table-bordered table-striped table-sm">
        <tr>
            <th>
                <center>Название</center>
            </th>
            <th>
                <center>Сезон</center>
            </th>
            <th>
                <center>Серия</center>
            </th>
            <th>
                <center>Жанр</center>
            </th>
            <th>
                <center>Стоп Время</center>
            </th>
            <th>
                <center>Комментарии</center>
            </th>
        </tr>
        @foreach (var p in Model.Series)
        {
            <tr>
                <td>
                    <center>
                        <a href=@p.Link target="_blank">@p.Name</a>
                    </center>
                    <p>
                        <center>
                            <img style='width:200px; height:260px;' src="@Url.Action("Avatar", "Serie", new { area = "Series", id = p.Id, width = 200, height = 260 })" loading="lazy" alt="@p.Name" />
                        </center>
                    </p>
                    <p>
                        <center>
                            <a asp-action="GoToIndex" asp-controller="Serie" asp-route-id="@p.Id" class="fas fa-film fa-lg fa-border" style="color: #0080ff;
                           role="button" title="В Список"></a>
                            <a asp-action="Edit" asp-controller="Serie" asp-route-id="@p.Id" class="fas fa-pen fa-lg fa-border" style="color: #008000;
                           role="button" title="Изменить"></a>
                            <a asp-action="Delete" asp-controller="Serie" asp-route-id="@p.Id" class="fas fa-trash-alt fa-lg fa-border" style="color: #ff0000;
                           role="button" title="Удалить"></a>
                        </center>
                    </p>
                </td>
                <td><center><a href="#" class="btn-season-episode" data-id="@p.Id" data-season="@p.Season" data-episode="@p.Episode" data-name="@p.Name" title="Изменить сезон/серию">@p.Season</a></center></td>
                <td><center><a href="#" class="btn-season-episode" data-id="@p.Id" data-season="@p.Season" data-episode="@p.Episode" data-name="@p.Name" title="Изменить сезон/серию">@p.Episode</a></center></td>
                <td><center>@p.Category</center></td>
                <td>
                    <center>
                        @if (p.HoldPlay.HasValue)
                        {
                            @p.HoldPlay.Value.TimeOfDay
                        }
                        else
                        {
                            @String.Empty
                        }
                    </center>
                </td>

                <td>                    
                </td>
            </tr>
        }
    </table>
</div>

@if (Model.PageViewModel.HasPreviousPage)
{
    <a asp-action="Favorite"
       asp-route-page="@(Model.PageViewModel.PageNumber - 1)"
       class="btn btn-outline-dark">
        <i class="glyphicon glyphicon-chevron-left"></i>
        Назад
    </a>
}
@if (Model.PageViewModel.HasNextPage)
{
    <a asp-action="Favorite"
       asp-route-page="@(Model.PageViewModel.PageNumber + 1)"
       class="btn btn-outline-dark">
        Вперед
        <i class="glyphicon glyphicon-chevron-right"></i>
    </a>
}
<p></p>

<!-- Модальное окно: Сезон / Серия -->
<div class="modal fade" id="seasonEpisodeModal" tabindex="-1" role="dialog" aria-labelledby="seasonEpisodeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="seasonEpisodeModalLabel">Сезон / Серия</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Закрыть">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                @Html.AntiForgeryToken()
                <input type="hidden" id="se-movie-id" />
                <div class="row">
                    <div class="col-6 text-center">
                        <label><strong>Сезон</strong></label>
                        <div>
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="se-season-up"><i class="fas fa-caret-up fa-lg"></i></button>
                        </div>
                        <input type="number" id="se-season" class="form-control text-center" min="0" style="max-width:80px; margin:5px auto;" />
                        <div>
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="se-season-down"><i class="fas fa-caret-down fa-lg"></i></button>
                        </div>
                    </div>
                    <div class="col-6 text-center">
                        <label><strong>Серия</strong></label>
                        <div>
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="se-episode-up"><i class="fas fa-caret-up fa-lg"></i></button>
                        </div>
                        <input type="number" id="se-episode" class="form-control text-center" min="0" style="max-width:80px; margin:5px auto;" />
                        <div>
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="se-episode-down"><i class="fas fa-caret-down fa-lg"></i></button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="se-save">Сохранить</button>
                <button type="button" class="btn btn-danger" data-dismiss="modal">Отмена</button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        // Открытие модального окна при клике на Сезон или Серию
        $('.btn-season-episode').on('click', function (e) {
            e.preventDefault();
            var id = $(this).data('id');
            var season = $(this).data('season');
            var episode = $(this).data('episode');
            $('#se-movie-id').val(id);
            $('#se-season').val(season);
            $('#se-episode').val(episode);
            $('#seasonEpisodeModal').modal('show');
        });

        // Кнопки +/- для Сезона
        $('#se-season-up').on('click', function () {
            var val = parseInt($('#se-season').val()) || 0;
            $('#se-season').val(val + 1);
        });
        $('#se-season-down').on('click', function () {
            var val = parseInt($('#se-season').val()) || 0;
            if (val > 0) $('#se-season').val(val - 1);
        });

        // Кнопки +/- для Серии
        $('#se-episode-up').on('click', function () {
            var val = parseInt($('#se-episode').val()) || 0;
            $('#se-episode').val(val + 1);
        });
        $('#se-episode-down').on('click', function () {
            var val = parseInt($('#se-episode').val()) || 0;
            if (val > 0) $('#se-episode').val(val - 1);
        });

        // Сохранение
        $('#se-save').on('click', function () {
            var id = parseInt($('#se-movie-id').val());
            var season = parseInt($('#se-season').val()) || 0;
            var episode = parseInt($('#se-episode').val()) || 0;

            var token = $('input[name="__RequestVerificationToken"]').val();
            $.ajax({
                url: '@Url.Action("UpdateSeasonEpisode", "Serie", new { area = "Series" })',
                type: 'POST',
                contentType: 'application/json',
                headers: { 'RequestVerificationToken': token },
                data: JSON.stringify({ id: id, season: season, episode: episode }),
                success: function (resp) {
                    if (resp.success) {
                        // Обновляем значения в таблице без перезагрузки
                        $('.btn-season-episode[data-id="' + id + '"]').each(function () {
                            $(this).data('season', resp.season);
                            $(this).data('episode', resp.episode);
                        });
                        // Обновляем отображаемый текст
                        var links = $('.btn-season-episode[data-id="' + id + '"]');
                        $(links[0]).text(resp.season);
                        $(links[1]).text(resp.episode);
                        $('#seasonEpisodeModal').modal('hide');
                    } else {
                        alert('Ошибка сохранения');
                    }
                },
                error: function () {
                    alert('Ошибка сохранения');
                }
            });
        });
    });
</script>

