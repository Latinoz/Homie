@model InvestmentTypeModel

@{
    ViewBag.Title = "Редактирование типа инструмента";
}

<style>
    .text-input-width { width: 400px; }
</style>

<h4>Редактировать тип инструмента</h4>
<hr>

<form asp-action="Edit" asp-route-id="@Model.Id">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label asp-for="Name" class="control-label">Название</label>
        <input asp-for="Name" class="form-control text-input-width" />
    </div>
    @if (Model.SystemCode != null)
    {
        <div class="form-group">
            <label class="control-label">Системный код</label>
            <input value="@Model.SystemCode" class="form-control text-input-width" readonly />
        </div>
    }
    <div class="form-group">
        <input type="submit" value="Сохранить" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-danger">Назад</a>
    </div>
</form>
