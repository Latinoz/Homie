@model InvestmentTypeModel

@{
    ViewBag.Title = "Удаление типа инструмента";
}

<h4>Удалить тип инструмента?</h4>
<hr>

<dl class="dl-horizontal">
    <dt>Название:</dt>
    <dd>@Model.Name</dd>
</dl>

@if (Model.SystemCode != null)
{
    <div class="w3-panel w3-pale-red w3-border">
        <p><strong>Внимание!</strong> Это системный тип. Удаление невозможно.</p>
    </div>
}

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <input type="submit" class="btn btn-danger" value="Удалить" />
    <a asp-action="Index" class="btn btn-secondary">Назад</a>
</form>
