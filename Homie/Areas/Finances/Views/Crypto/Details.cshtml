@model CryptoAssetModel

@{
    ViewBag.Title = "Криптоактив — детали";
}

<style>
    .positive { color: green; font-weight: bold; }
    .negative { color: red; font-weight: bold; }
    .chart-container { position: relative; height: 250px; margin: 15px 0; }
</style>

<h4><i class="fab fa-bitcoin"></i> @Model.Ticker — @Model.Instrument?.Name</h4>
<hr>

<div class="w3-row-padding">
    <div class="w3-half">
        @{
            var total = Model.Quantity * Model.CurrentPrice;
            var cost = Model.Quantity * Model.AvgPurchasePrice;
            var pl = cost != 0 ? (total - cost) / cost * 100 : 0;
        }
        <table class="table table-sm">
            <tr><td><strong>CoinGecko ID</strong></td><td>@Model.CoinGeckoId</td></tr>
            <tr><td><strong>Кошелёк / Биржа</strong></td><td>@(Model.Account?.Wallet?.Name ?? Model.Account?.CryptoExchange?.Name ?? Model.Account?.Name)</td></tr>
            <tr><td><strong>Валюта</strong></td><td>@Model.Currency?.Code</td></tr>
            <tr><td><strong>Количество</strong></td><td>@Model.Quantity.ToString("0.############")</td></tr>
            <tr><td><strong>Ср. цена покупки</strong></td><td>@Model.AvgPurchasePrice.ToString("N2")</td></tr>
            <tr><td><strong>Текущая цена</strong></td><td>@Model.CurrentPrice.ToString("N2")</td></tr>
            <tr><td><strong>Стоимость</strong></td><td>@total.ToString("N2") @Model.Currency?.Code</td></tr>
            <tr>
                <td><strong>P/L</strong></td>
                <td class="@(pl >= 0 ? "positive" : "negative")">@(pl >= 0 ? "+" : "")@pl.ToString("N2")%</td>
            </tr>
            <tr><td><strong>Кошелёк</strong></td><td>@Model.WalletAddress</td></tr>
            <tr><td><strong>Авто-обновление</strong></td><td>@(Model.IsAutoUpdateEnabled ? "Да" : "Нет")</td></tr>
        </table>
    </div>
    <div class="w3-half">
        <div class="w3-card w3-padding">
            <h5>График цены</h5>
            <div class="chart-container">
                <canvas id="priceChart"></canvas>
            </div>
        </div>
    </div>
</div>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Редактировать</a>
<a asp-action="Index" class="btn btn-secondary">Назад</a>

@section Scripts {
<script>
    var chartData = @Html.Raw(ViewBag.PriceChartJson ?? "{}");
    if (chartData.labels) {
        new Chart(document.getElementById('priceChart'), {
            type: 'line', data: chartData,
            options: { responsive: true, maintainAspectRatio: false, scales: { y: { beginAtZero: false } } }
        });
    }
</script>
}
