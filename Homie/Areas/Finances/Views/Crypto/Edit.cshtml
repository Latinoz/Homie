@model CryptoAssetModel

@{
    ViewBag.Title = "Редактирование криптоактива";
    var accounts = (IEnumerable<AccountModel>)ViewBag.Accounts;
    var walletAccounts = accounts.Where(a => a.AccountType == AccountType.Wallet).ToList();
    var exchangeAccounts = accounts.Where(a => a.AccountType == AccountType.CryptoExchange).ToList();
}

<style>
    .text-input-width { width: 400px; }
    .number-input-width { width: 200px; }
</style>

<h4>Редактировать — @Model.Ticker</h4>
<hr>

<form asp-action="Edit" asp-route-id="@Model.Id">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="InstrumentId" />
    <input type="hidden" asp-for="Quantity" />
    <input type="hidden" asp-for="AvgPurchasePrice" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        <label class="control-label">Инструмент</label>
        <input type="text" class="form-control text-input-width" value="@Model.Instrument?.Name" readonly />
    </div>
    <div class="form-group">
        <label asp-for="Ticker" class="control-label">Тикер</label>
        <input asp-for="Ticker" class="form-control text-input-width" />
    </div>
    <div class="form-group">
        <label asp-for="CoinGeckoId" class="control-label">CoinGecko ID</label>
        <input asp-for="CoinGeckoId" class="form-control text-input-width" />
    </div>
    <div class="form-group">
        <label asp-for="AccountId" class="control-label">Кошелёк / Биржа</label>
        <select asp-for="AccountId" class="form-control text-input-width">
            <option value="">-- Не выбрано --</option>
            @if (walletAccounts.Any())
            {
                <optgroup label="Кошельки">
                    @foreach (var a in walletAccounts)
                    {
                        <option value="@a.Id" selected="@(Model.AccountId == a.Id)">@(a.Wallet?.Name ?? a.Name)</option>
                    }
                </optgroup>
            }
            @if (exchangeAccounts.Any())
            {
                <optgroup label="Биржи">
                    @foreach (var a in exchangeAccounts)
                    {
                        <option value="@a.Id" selected="@(Model.AccountId == a.Id)">@(a.CryptoExchange?.Name ?? a.Name)</option>
                    }
                </optgroup>
            }
        </select>
        <span asp-validation-for="AccountId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="CurrencyId" class="control-label">Валюта учёта</label>
        <select asp-for="CurrencyId" asp-items="@(new SelectList(ViewBag.Currencies, "Id", "Code"))" class="form-control text-input-width"></select>
    </div>
    <div class="form-group">
        <label class="control-label">Количество</label>
        <input type="text" class="form-control number-input-width" value="@Model.Quantity.ToString("0.############")" readonly />
        <small class="form-text text-muted">Количество меняется через Журнал операций (покупка/продажа криптовалюты).</small>
    </div>
    <div class="form-group">
        <label class="control-label">Средняя цена покупки</label>
        <input type="text" class="form-control number-input-width" value="@Model.AvgPurchasePrice.ToString("N2")" readonly />
    </div>
    <div class="form-group">
        <label asp-for="CurrentPrice" class="control-label">Текущая цена</label>
        <input asp-for="CurrentPrice" type="number" step="0.01" class="form-control number-input-width" />
        <div class="form-check mt-1">
            <input type="checkbox" name="manualPriceOverride" value="true" class="form-check-input" id="manualOverride" />
            <label class="form-check-label" for="manualOverride">Ручная корректировка цены</label>
        </div>
    </div>
    <div class="form-group">
        <label asp-for="WalletAddress" class="control-label">Адрес кошелька</label>
        <input asp-for="WalletAddress" class="form-control text-input-width" />
    </div>
    <div class="form-group form-check">
        <input asp-for="IsAutoUpdateEnabled" class="form-check-input" />
        <label asp-for="IsAutoUpdateEnabled" class="form-check-label">Авто-обновление цены</label>
    </div>
    <div class="form-group">
        <input type="submit" value="Сохранить" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-danger">Назад</a>
    </div>
</form>
