@model CryptoAssetModel

@{
    ViewBag.Title = "Удаление криптоактива";
}

<h4>Удалить криптоактив?</h4>
<hr>

<dl class="dl-horizontal">
    <dt>Тикер:</dt><dd>@Model.Ticker</dd>
    <dt>Название:</dt><dd>@Model.Instrument?.Name</dd>
    <dt>Кол-во:</dt><dd>@Model.Quantity.ToString("N8")</dd>
    <dt>Стоимость:</dt><dd>@((Model.Quantity * Model.CurrentPrice).ToString("N2"))</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <input type="submit" class="btn btn-danger" value="Удалить" />
    <a asp-action="Index" class="btn btn-secondary">Назад</a>
</form>
