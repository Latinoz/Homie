@model CryptoListViewModel

@addTagHelper *, Homie

@{
    ViewBag.Title = "Криптовалюта";
}

<style>
    .scroll-x { overflow-x: auto; }
    .positive { color: green; }
    .negative { color: red; }
</style>

@if (TempData["PriceUpdateMsg"] != null)
{
    <div class="w3-panel w3-pale-green w3-border"><p>@TempData["PriceUpdateMsg"]</p></div>
}

<a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus"></i> Новый криптоактив</a>
<p></p>

<form method="get" class="form-inline">
    <label>Тикер: </label>
    <input name="name" value="@Model.NameFilter" class="form-control ml-1 mr-2" />
    <input type="submit" value="Фильтр" class="btn btn-outline-dark" />
</form>
<p></p>

<div><label>Всего: @Model.PageViewModel.CountPages</label></div>

<div class="scroll-x">
    <table class="table table-bordered table-striped table-sm">
        <thead>
            <tr>
                <th><a asp-action="Index" asp-route-sortOrder="@(Model.CurrentSort == FinanceSortState.NameAsc ? FinanceSortState.NameDesc : FinanceSortState.NameAsc)">Тикер</a></th>
                <th>Название</th>
                <th>Кол-во</th>
                <th>Ср. цена покупки</th>
                <th>Тек. цена</th>
                <th><a asp-action="Index" asp-route-sortOrder="@(Model.CurrentSort == FinanceSortState.AmountAsc ? FinanceSortState.AmountDesc : FinanceSortState.AmountAsc)">Стоимость</a></th>
                <th>P/L %</th>
                <th>Кошелёк</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model.Assets)
            {
                var total = a.Quantity * a.CurrentPrice;
                var cost = a.Quantity * a.AvgPurchasePrice;
                var pl = cost != 0 ? (total - cost) / cost * 100 : 0;
                <tr>
                    <td><a asp-action="Details" asp-route-id="@a.Id">@a.Ticker</a></td>
                    <td>@a.Instrument?.Name</td>
                    <td>@a.Quantity.ToString("N6")</td>
                    <td>@a.AvgPurchasePrice.ToString("N2")</td>
                    <td>@a.CurrentPrice.ToString("N2")</td>
                    <td>@total.ToString("N2") @a.Currency?.Code</td>
                    <td class="@(pl >= 0 ? "positive" : "negative")">@pl.ToString("N1")%</td>
                    <td>@a.WalletAddress?.Substring(0, Math.Min(a.WalletAddress?.Length ?? 0, 12))...</td>
                    <td>
                        <form asp-action="UpdatePrice" method="post" style="display:inline;">
                            <input type="hidden" name="instrumentId" value="@a.InstrumentId" />
                            <button type="submit" class="btn btn-sm btn-outline-info"><i class="fas fa-sync-alt"></i></button>
                        </form>
                        <a asp-action="Edit" asp-route-id="@a.Id" class="fas fa-pen" style="color:green;"></a>
                        <a asp-action="Delete" asp-route-id="@a.Id" class="fas fa-trash-alt" style="color:red;"></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<page-link page-model="Model.PageViewModel" page-action="Index"
           page-url-name="@Model.NameFilter"
           page-url-sortorder="@Model.CurrentSort"></page-link>
