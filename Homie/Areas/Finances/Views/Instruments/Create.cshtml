@model InstrumentModel

@{
    ViewBag.Title = "Новый инструмент";
}

<style>
    .text-input-width { width: 400px; }
</style>

<h4>Добавить финансовый инструмент</h4>
<hr>

<form asp-action="Create">
    <div class="form-group">
        <label asp-for="Name" class="control-label">Название</label>
        <input asp-for="Name" class="form-control text-input-width" />
    </div>
    <div class="form-group">
        <label asp-for="Code" class="control-label">Тикер / Код</label>
        <input asp-for="Code" class="form-control text-input-width" placeholder="Заполнится автоматически, если оставить пустым" />
    </div>
    <div class="form-group">
        <label asp-for="InvestmentTypeId" class="control-label">Тип</label>
        <select asp-for="InvestmentTypeId" asp-items="@(new SelectList(ViewBag.InvestmentTypes, "Id", "Name"))" class="form-control text-input-width"></select>
    </div>
    <div class="form-group">
        <label asp-for="Exchange" class="control-label">Биржа</label>
        <select asp-for="Exchange" asp-items="Html.GetEnumSelectList<Exchange>()" class="form-control text-input-width"></select>
    </div>
    <div class="form-group">
        <label asp-for="CurrencyId" class="control-label">Валюта</label>
        <select asp-for="CurrencyId" asp-items="@(new SelectList(ViewBag.Currencies, "Id", "Code"))" class="form-control text-input-width"></select>
    </div>
    <div class="form-group">
        <label asp-for="ExternalCode" class="control-label">Внешний код (для API)</label>
        <input asp-for="ExternalCode" class="form-control text-input-width" placeholder="MOEX SECID, Yahoo ticker, CoinGecko ID" />
    </div>
    <div class="form-group">
        <label asp-for="ISIN" class="control-label">ISIN</label>
        <input asp-for="ISIN" class="form-control text-input-width" />
    </div>
    <div class="form-group">
        <input type="submit" value="Добавить" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">Назад</a>
    </div>
</form>
