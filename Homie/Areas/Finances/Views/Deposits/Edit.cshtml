@model DepositModel

@{
    ViewBag.Title = "Редактирование депозита";
}

<style>
    .text-input-width { width: 400px; }
    .number-input-width { width: 150px; }
</style>

<h4>Редактировать депозит</h4>
<hr>

<form asp-action="Edit" asp-route-id="@Model.Id">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label asp-for="Name" class="control-label">Название</label>
        <input asp-for="Name" class="form-control text-input-width" />
    </div>
    <div class="form-group">
        <label asp-for="AccountId" class="control-label">Счёт</label>
        <select asp-for="AccountId" asp-items="@(new SelectList(ViewBag.Accounts, "Id", "Name"))" class="form-control text-input-width"></select>
    </div>
    <div class="form-group">
        <label asp-for="CurrencyId" class="control-label">Валюта</label>
        <select asp-for="CurrencyId" asp-items="@(new SelectList(ViewBag.Currencies, "Id", "Code"))" class="form-control text-input-width"></select>
    </div>
    <div class="form-group">
        <label asp-for="Amount" class="control-label">Сумма</label>
        <input asp-for="Amount" type="number" step="0.01" class="form-control number-input-width" />
    </div>
    <div class="form-group">
        <label asp-for="InterestRate" class="control-label">Процентная ставка, %</label>
        <input asp-for="InterestRate" type="number" step="0.01" class="form-control number-input-width" />
    </div>
    <div class="form-group">
        <label asp-for="OpenDate" class="control-label">Дата открытия</label>
        <input asp-for="OpenDate" type="date" class="form-control number-input-width" />
    </div>
    <div class="form-group">
        <label asp-for="EndDate" class="control-label">Дата закрытия</label>
        <input asp-for="EndDate" type="date" class="form-control number-input-width" />
    </div>
    <div class="form-group form-check">
        <input asp-for="IsCapitalization" class="form-check-input" />
        <label asp-for="IsCapitalization" class="form-check-label">Капитализация процентов</label>
    </div>
    <div class="form-group">
        <label asp-for="Notes" class="control-label">Комментарий</label>
        <textarea asp-for="Notes" class="form-control text-input-width" rows="2"></textarea>
    </div>
    <div class="form-group">
        <input type="submit" value="Сохранить" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-danger">Назад</a>
    </div>
</form>
