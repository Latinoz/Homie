@model DepositModel

@{
    ViewBag.Title = "Удаление депозита";
}

<h4>Удалить депозит?</h4>
<hr>

<dl class="dl-horizontal">
    <dt>Название:</dt><dd>@Model.Name</dd>
    <dt>Счёт:</dt><dd>@Model.Account?.Name</dd>
    <dt>Сумма:</dt><dd>@Model.Amount.ToString("N2") @Model.Currency?.Code</dd>
    <dt>Ставка:</dt><dd>@Model.InterestRate%</dd>
    <dt>Дата открытия:</dt><dd>@Model.OpenDate.ToString("dd.MM.yyyy")</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <input type="submit" class="btn btn-danger" value="Удалить" />
    <a asp-action="Index" class="btn btn-secondary">Назад</a>
</form>
