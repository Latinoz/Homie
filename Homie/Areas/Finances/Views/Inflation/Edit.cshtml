@model InflationModel

@{
    ViewBag.Title = "Редактирование — инфляция";
}

<style>
    .number-input-width { width: 150px; }
</style>

<h4>Редактировать запись инфляции</h4>
<hr>

<form asp-action="Edit" asp-route-id="@Model.Id">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label asp-for="Year" class="control-label">Год</label>
        <input asp-for="Year" type="number" class="form-control number-input-width" />
    </div>
    <div class="form-group">
        <label asp-for="Month" class="control-label">Месяц (1-12)</label>
        <input asp-for="Month" type="number" min="1" max="12" class="form-control number-input-width" />
    </div>
    <div class="form-group">
        <label asp-for="CpiPercent" class="control-label">ИПЦ, %</label>
        <input asp-for="CpiPercent" type="number" step="0.01" class="form-control number-input-width" />
    </div>
    <div class="form-group">
        <label asp-for="AccumulatedYearPercent" class="control-label">Накопленная за год, %</label>
        <input asp-for="AccumulatedYearPercent" type="number" step="0.01" class="form-control number-input-width" />
    </div>
    <div class="form-group">
        <input type="submit" value="Сохранить" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-danger">Назад</a>
    </div>
</form>
