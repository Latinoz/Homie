@model CryptoExchangeListViewModel

@{
    ViewBag.Title = "Крипто биржи";
}

<h4><i class="fab fa-bitcoin"></i> Крипто биржи</h4>
<hr>

<div>
    <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus"></i> Добавить крипто биржу</a>
</div>
<p></p>

<table class="table table-bordered table-sm">
    <thead>
        <tr>
            <th>Название</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model.CryptoExchanges)
        {
            <tr>
                <td>@c.Name</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@c.Id" class="fas fa-pen" style="color:green;" title="Изменить"></a>
                    <a asp-action="Delete" asp-route-id="@c.Id" class="fas fa-trash-alt" style="color:red;" title="Удалить"></a>
                </td>
            </tr>
        }
    </tbody>
</table>
