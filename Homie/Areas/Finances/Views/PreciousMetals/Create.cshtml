@model PreciousMetalModel

@{
    ViewBag.Title = "Новая позиция — драгметаллы";
}

<style>
    .text-input-width { width: 400px; }
    .number-input-width { width: 150px; }
</style>

<h4>Добавить драгметалл</h4>
<hr>

<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="Name" class="control-label">Название (напр. «Мерный слиток 10г»)</label>
        <input asp-for="Name" class="form-control text-input-width" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Metal" class="control-label">Металл</label>
        <select asp-for="Metal" asp-items="Html.GetEnumSelectList<MetalType>()" class="form-control text-input-width"></select>
    </div>
    <div class="form-group">
        <label asp-for="WeightGrams" class="control-label">Вес единицы, грамм</label>
        <input asp-for="WeightGrams" type="number" step="0.01" class="form-control number-input-width" />
        <span asp-validation-for="WeightGrams" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Quantity" class="control-label">Количество</label>
        <input asp-for="Quantity" type="number" class="form-control number-input-width" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="PurchasePrice" class="control-label">Цена покупки за грамм ₽</label>
        <input asp-for="PurchasePrice" type="number" step="0.01" class="form-control number-input-width" />
    </div>
    <div class="form-group">
        <label asp-for="CurrentPricePerGram" class="control-label">Текущая цена за грамм ₽</label>
        <input asp-for="CurrentPricePerGram" type="number" step="0.01" class="form-control number-input-width" />
    </div>
    <div class="form-group">
        <label asp-for="PurchaseDate" class="control-label">Дата покупки</label>
        <input asp-for="PurchaseDate" type="date" class="form-control number-input-width" />
    </div>
    <div class="form-group">
        <label asp-for="Notes" class="control-label">Комментарий</label>
        <textarea asp-for="Notes" class="form-control text-input-width" rows="2"></textarea>
    </div>
    <div class="form-group">
        <input type="submit" value="Добавить" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">Назад</a>
    </div>
</form>
