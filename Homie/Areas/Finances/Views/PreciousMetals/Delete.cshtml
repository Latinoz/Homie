@model PreciousMetalModel

@{
    ViewBag.Title = "Удаление — драгметалл";
}

<h4>Удалить позицию?</h4>
<hr>

<dl class="dl-horizontal">
    <dt>Название:</dt><dd>@Model.Name</dd>
    <dt>Металл:</dt><dd>@Model.Metal</dd>
    <dt>Вес:</dt><dd>@Model.WeightGrams г × @Model.Quantity = @Model.TotalWeightGrams г</dd>
    <dt>Стоимость:</dt><dd>@Model.TotalValueRub.ToString("N0") ₽</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <input type="submit" class="btn btn-danger" value="Удалить" />
    <a asp-action="Index" class="btn btn-secondary">Назад</a>
</form>
