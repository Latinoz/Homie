@model WalletModel

@{
    ViewBag.Title = "Редактирование кошелька";
}

<style>
    .text-input-width { width: 400px; }
</style>

<h4>Редактировать кошелёк</h4>
<hr>

<form asp-action="Edit" asp-route-id="@Model.Id">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label asp-for="Name" class="control-label">Название</label>
        <input asp-for="Name" class="form-control text-input-width" />
    </div>
    <div class="form-group">
        <label asp-for="Type" class="control-label">Тип кошелька</label>
        <select asp-for="Type" asp-items="Html.GetEnumSelectList<WalletType>()" class="form-control text-input-width"></select>
        <small class="form-text text-muted">Для криптокошелька автоматически создаётся связанный финансовый счёт.</small>
    </div>
    <div class="form-group">
        <label asp-for="CurrencyId" class="control-label">Валюта</label>
        <select asp-for="CurrencyId" class="form-control text-input-width">
            <option value="">— не выбрана —</option>
            @foreach (var c in (IEnumerable<CurrencyModel>)ViewBag.Currencies)
            {
                <option value="@c.Id" selected="@(Model.CurrencyId == c.Id)">@c.Code - @c.Name</option>
            }
        </select>
    </div>
    <div class="form-group">
        <input type="submit" value="Сохранить" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-danger">Назад</a>
    </div>
</form>
