@model WalletModel

@{
    ViewBag.Title = "Новый кошелёк";
}

<style>
    .text-input-width { width: 400px; }
</style>

<h4>Добавить кошелёк</h4>
<hr>

<form asp-action="Create">
    <div class="form-group">
        <label asp-for="Name" class="control-label">Название</label>
        <input asp-for="Name" class="form-control text-input-width" />
    </div>
    <div class="form-group">
        <label asp-for="CurrencyId" class="control-label">Валюта</label>
        <select asp-for="CurrencyId" class="form-control text-input-width">
            <option value="">— не выбрана —</option>
            @foreach (var c in (IEnumerable<CurrencyModel>)ViewBag.Currencies)
            {
                <option value="@c.Id">@c.Code - @c.Name</option>
            }
        </select>
    </div>
    <div class="form-group">
        <input type="submit" value="Добавить" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">Назад</a>
    </div>
</form>
