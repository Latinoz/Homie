@model OperationModel

@{
    ViewBag.Title = "Редактирование операции";
}

<style>
    .text-input-width { width: 400px; }
    .number-input-width { width: 150px; }
</style>

<h4>Редактировать операцию</h4>
<hr>

<form asp-action="Edit" asp-route-id="@Model.Id">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label asp-for="Date" class="control-label">Дата</label>
        <input asp-for="Date" type="date" class="form-control number-input-width" />
    </div>
    <div class="form-group">
        <label asp-for="OperationTypeId" class="control-label">Тип операции</label>
        <select asp-for="OperationTypeId" asp-items="@(new SelectList(ViewBag.OperationTypes, "Id", "Name"))" class="form-control text-input-width"></select>
    </div>
    <div class="form-group">
        <label asp-for="AccountId" class="control-label">Счёт</label>
        <select asp-for="AccountId" asp-items="@(new SelectList(ViewBag.Accounts, "Id", "Name"))" class="form-control text-input-width"></select>
    </div>
    <div class="form-group">
        <label asp-for="InstrumentId" class="control-label">Инструмент</label>
        <select asp-for="InstrumentId" asp-items="@(new SelectList(ViewBag.Instruments, "Id", "Name"))" class="form-control text-input-width">
            <option value="">-- Не выбран --</option>
        </select>
    </div>
    <div class="form-group">
        <label asp-for="CurrencyId" class="control-label">Валюта</label>
        <select asp-for="CurrencyId" asp-items="@(new SelectList(ViewBag.Currencies, "Id", "Code"))" class="form-control text-input-width"></select>
    </div>
    <div class="form-group">
        <label asp-for="Quantity" class="control-label">Количество</label>
        <input asp-for="Quantity" type="number" step="0.000001" class="form-control number-input-width" />
    </div>
    <div class="form-group">
        <label asp-for="Price" class="control-label">Цена за единицу</label>
        <input asp-for="Price" type="number" step="0.01" class="form-control number-input-width" />
    </div>
    <div class="form-group">
        <label asp-for="AmountInRub" class="control-label">Сумма в валюте</label>
        <input asp-for="AmountInRub" type="number" step="0.01" class="form-control number-input-width" />
    </div>
    <div class="form-group">
        <label asp-for="AmountInRub" class="control-label">Сумма в ₽</label>
        <input asp-for="AmountInRub" type="number" step="0.01" class="form-control number-input-width" />
    </div>
    <div class="form-group">
        <label asp-for="Commission" class="control-label">Комиссия</label>
        <input asp-for="Commission" type="number" step="0.01" class="form-control number-input-width" />
    </div>
    <div class="form-group">
        <label asp-for="Notes" class="control-label">Комментарий</label>
        <textarea asp-for="Notes" class="form-control text-input-width" rows="2"></textarea>
    </div>
    <div class="form-group">
        <input type="submit" value="Сохранить" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-danger">Назад</a>
    </div>
</form>
