@model OperationModel

@{
    ViewBag.Title = "Новая операция";
}

<style>
    .text-input-width { width: 400px; }
    .number-input-width { width: 150px; }
</style>

<h4>Добавить операцию</h4>
<hr>

<form asp-action="Create">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="Date" class="control-label">Дата</label>
        <input asp-for="Date" type="date" class="form-control number-input-width" />
    </div>
    <div class="form-group">
        <label asp-for="OperationTypeId" class="control-label">Тип операции</label>
        <select asp-for="OperationTypeId" asp-items="@(new SelectList(ViewBag.OperationTypes, "Id", "Name"))" class="form-control text-input-width">
            <option value="">-- Выберите --</option>
        </select>
    </div>
    <div class="form-group">
        <label asp-for="AccountId" class="control-label">Счёт</label>
        <select asp-for="AccountId" asp-items="@(new SelectList(ViewBag.Accounts, "Id", "Name"))" class="form-control text-input-width">
            <option value="">-- Выберите --</option>
        </select>
    </div>
    <div class="form-group">
        <label asp-for="InstrumentId" class="control-label">Инструмент (если применимо)</label>
        <select asp-for="InstrumentId" asp-items="@(new SelectList(ViewBag.Instruments, "Id", "Name"))" class="form-control text-input-width">
            <option value="">-- Не выбран --</option>
        </select>
    </div>
    <div class="form-group">
        <label asp-for="CurrencyId" class="control-label">Валюта</label>
        <select asp-for="CurrencyId" asp-items="@(new SelectList(ViewBag.Currencies, "Id", "Code"))" class="form-control text-input-width"></select>
    </div>
    <div class="form-group">
        <label asp-for="Quantity" class="control-label">Количество</label>
        <input asp-for="Quantity" type="number" step="0.000001" class="form-control number-input-width" />
    </div>
    <div class="form-group">
        <label asp-for="Price" class="control-label">Цена за единицу</label>
        <input asp-for="Price" type="number" step="0.01" class="form-control number-input-width" />
    </div>
    <div class="form-group">
        <label asp-for="AmountInRub" class="control-label">Сумма в валюте</label>
        <input asp-for="AmountInRub" type="number" step="0.01" class="form-control number-input-width" />
    </div>
    <div class="form-group">
        <label asp-for="AmountInRub" class="control-label">Сумма в ₽</label>
        <input asp-for="AmountInRub" type="number" step="0.01" class="form-control number-input-width" />
    </div>
    <div class="form-group">
        <label asp-for="Commission" class="control-label">Комиссия</label>
        <input asp-for="Commission" type="number" step="0.01" class="form-control number-input-width" />
    </div>
    <div class="form-group">
        <label asp-for="Notes" class="control-label">Комментарий</label>
        <textarea asp-for="Notes" class="form-control text-input-width" rows="2"></textarea>
    </div>
    <div class="form-group">
        <input type="submit" value="Добавить" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">Назад</a>
    </div>
</form>

<script>
(function () {
    var opTypes = @Html.Raw(ViewBag.OperationTypesJson);
    var instruments = @Html.Raw(ViewBag.InstrumentsJson);

    // Category(enum) → допустимые InvestmentTypeId (из таблицы InvestmentTypes)
    // Investment(1) → Stock(1), Bond(2), ETF(3), Currency(6)
    // Crypto(2) → Crypto(4)
    // PreciousMetal(3) → PreciousMetal(5)
    var categoryToTypes = { 1: [1,2,3,6], 2: [4], 3: [5] };

    var opTypeMap = {};
    opTypes.forEach(function(ot) { opTypeMap[ot.Id] = ot.Category; });
    var instrMap = {};
    instruments.forEach(function(i) { instrMap[i.Id] = i.Type; });

    var opTypeSelect = document.getElementById('OperationTypeId');
    var instrSelect = document.getElementById('InstrumentId');
    var instrGroup = instrSelect.closest('.form-group');

    // Сохранить все опции инструментов
    var allOptions = Array.from(instrSelect.options);

    function filterInstruments() {
        var opTypeId = parseInt(opTypeSelect.value);
        var category = opTypeMap[opTypeId];
        var allowedTypes = categoryToTypes[category];

        // Очистить
        instrSelect.innerHTML = '';
        // Добавить пустую опцию
        var emptyOpt = document.createElement('option');
        emptyOpt.value = '';
        emptyOpt.textContent = '-- Не выбран --';
        instrSelect.appendChild(emptyOpt);

        if (!allowedTypes) {
            instrGroup.style.display = 'none';
            instrSelect.value = '';
            return;
        }

        instrGroup.style.display = '';
        allOptions.forEach(function(opt) {
            if (opt.value === '') return; // пропустить пустую
            var iType = instrMap[parseInt(opt.value)];
            if (allowedTypes.indexOf(iType) !== -1) {
                instrSelect.appendChild(opt.cloneNode(true));
            }
        });
    }

    opTypeSelect.addEventListener('change', filterInstruments);
    filterInstruments();
})();
</script>
