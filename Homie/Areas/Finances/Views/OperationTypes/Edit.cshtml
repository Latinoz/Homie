@model OperationTypeModel

@{
    ViewBag.Title = "Редактирование типа операции";
}

<style>
    .text-input-width { width: 400px; }
</style>

<h4>Редактировать тип операции</h4>
<hr>

<form asp-action="Edit" asp-route-id="@Model.Id">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label asp-for="Name" class="control-label">Название</label>
        <input asp-for="Name" class="form-control text-input-width" maxlength="100" />
    </div>
    <div class="form-group">
        <label asp-for="Category" class="control-label">Категория</label>
        <select asp-for="Category" class="form-control text-input-width">
            @foreach (OperationCategory c in Enum.GetValues(typeof(OperationCategory)))
            {
                <option value="@c" selected="@(Model.Category == c)">@c.GetDisplayName()</option>
            }
        </select>
    </div>
    <div class="form-group">
        <input type="submit" value="Сохранить" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-danger">Назад</a>
    </div>
</form>
