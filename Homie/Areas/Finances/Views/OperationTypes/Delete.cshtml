@model OperationTypeModel

@{
    ViewBag.Title = "Удаление типа операции";
}

<h4>Удалить тип операции?</h4>
<hr>

@if ((bool)ViewBag.IsUsed)
{
    <div class="w3-panel w3-pale-red w3-border">
        <p><strong>Внимание:</strong> Этот тип операции используется в журнале операций. Удаление невозможно.</p>
    </div>
}

<dl class="dl-horizontal">
    <dt>Название:</dt><dd>@Model.Name</dd>
    <dt>Категория:</dt><dd>@Model.Category</dd>
</dl>

@if (!(bool)ViewBag.IsUsed)
{
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <input type="submit" class="btn btn-danger" value="Удалить" />
        <a asp-action="Index" class="btn btn-secondary">Назад</a>
    </form>
}
else
{
    <a asp-action="Index" class="btn btn-secondary">Назад</a>
}
