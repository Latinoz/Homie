@model BrokerListViewModel

@{
    ViewBag.Title = "Брокеры";
}

<h4><i class="fas fa-chart-line"></i> Брокеры</h4>
<hr>

<div>
    <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus"></i> Добавить брокера</a>
</div>
<p></p>

<table class="table table-bordered table-sm">
    <thead>
        <tr>
            <th>Название</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var b in Model.Brokers)
        {
            <tr>
                <td>@b.Name</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@b.Id" class="fas fa-pen" style="color:green;" title="Изменить"></a>
                    <a asp-action="Delete" asp-route-id="@b.Id" class="fas fa-trash-alt" style="color:red;" title="Удалить"></a>
                </td>
            </tr>
        }
    </tbody>
</table>
