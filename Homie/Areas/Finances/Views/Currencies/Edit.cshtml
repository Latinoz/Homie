@model CurrencyModel

@{
    ViewBag.Title = "Редактирование валюты";
}

<style>
    .text-input-width { width: 300px; }
</style>

<h4>Редактировать валюту</h4>
<hr>

<form asp-action="Edit" asp-route-id="@Model.Id">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label asp-for="Code" class="control-label">Код</label>
        <input asp-for="Code" class="form-control text-input-width" maxlength="10" />
    </div>
    <div class="form-group">
        <label asp-for="Name" class="control-label">Название</label>
        <input asp-for="Name" class="form-control text-input-width" />
    </div>
    <div class="form-group form-check">
        <input asp-for="IsBase" class="form-check-input" />
        <label asp-for="IsBase" class="form-check-label">Базовая валюта</label>
    </div>
    <div class="form-group">
        <input type="submit" value="Сохранить" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-danger">Назад</a>
    </div>
</form>
