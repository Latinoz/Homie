@model InvestmentPositionModel

@{
    ViewBag.Title = "Редактирование позиции";
}

<style>
    .text-input-width { width: 400px; }
    .number-input-width { width: 150px; }
</style>

<h4>Редактировать позицию — @Model.Instrument?.Name</h4>
<hr>

<form asp-action="Edit" asp-route-id="@Model.Id">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="InstrumentId" />
    <div class="form-group">
        <label class="control-label">Инструмент</label>
        <input type="text" class="form-control text-input-width" value="@Model.Instrument?.Name" readonly />
    </div>
    <div class="form-group">
        <label asp-for="AccountId" class="control-label">Брокерский счёт</label>
        <select asp-for="AccountId" asp-items="@(new SelectList(ViewBag.Accounts, "Id", "Name"))" class="form-control text-input-width"></select>
    </div>
    <div class="form-group">
        <label asp-for="Quantity" class="control-label">Количество</label>
        <input asp-for="Quantity" type="number" step="0.000001" class="form-control number-input-width" />
    </div>
    <div class="form-group">
        <label asp-for="AvgPurchasePrice" class="control-label">Средняя цена покупки</label>
        <input asp-for="AvgPurchasePrice" type="number" step="0.01" class="form-control number-input-width" />
    </div>
    <div class="form-group">
        <label asp-for="CurrentPrice" class="control-label">Текущая цена</label>
        <input asp-for="CurrentPrice" type="number" step="0.01" class="form-control number-input-width" />
        <div class="form-check mt-1">
            <input type="checkbox" name="manualPriceOverride" value="true" class="form-check-input" id="manualOverride" />
            <label class="form-check-label" for="manualOverride">Ручная корректировка цены (заблокирует авто-обновление)</label>
        </div>
    </div>
    <div class="form-group form-check">
        <input asp-for="IsAutoUpdateEnabled" class="form-check-input" />
        <label asp-for="IsAutoUpdateEnabled" class="form-check-label">Авто-обновление цены</label>
    </div>
    <div class="form-group">
        <label asp-for="Notes" class="control-label">Комментарий</label>
        <textarea asp-for="Notes" class="form-control text-input-width" rows="2"></textarea>
    </div>
    <div class="form-group">
        <input type="submit" value="Сохранить" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-danger">Назад</a>
    </div>
</form>
