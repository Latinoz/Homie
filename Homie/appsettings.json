{
  // SECURITY WARNING: НЕ храните учетные данные базы данных в appsettings.json!
  // 
  // Для разработки используйте User Secrets:
  //   dotnet user-secrets init
  //   dotnet user-secrets set "ConnectionStrings:DefaultConnection" "Server=localhost;User Id=dev_user;Password=dev_pass;Database=homiedb_dev"
  //
  // Для продакшена используйте переменные окружения или Azure Key Vault:
  //   - В Azure App Service: Configuration -> Application settings
  //   - В Docker: передавайте через environment variables
  //   - Переменная окружения: ConnectionStrings__DefaultConnection
  //
  // Текущая пустая строка подключения будет переопределена через User Secrets или переменные окружения
  "ConnectionStrings": {
    "DefaultConnection": "Server='';User Id='';Password='';Database='';Convert Zero Datetime=True"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FileUpload": {
    "MaxFileSizeBytes": 5242880,
    "AllowedImageTypes": ["image/jpeg", "image/jpg", "image/png", "image/gif", "image/bmp", "image/webp"]
  }
}
